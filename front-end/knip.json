{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"svelte": {
		"entry": [
			"src/routes/**/+{page,layout,server,error}.{js,ts,svelte}",
			"src/hooks.{server,client}.{js,ts}",
			"src/app.d.ts"
		]
	},
	"entry": [
		"scripts/**/*.js",
		"src/lib/server/**/*.{js,ts}",
		"src/lib/utils/**/*.{js,ts}",
		"src/lib/types/**/*.{js,ts}",
		"src/lib/stores/**/*.{js,ts}"
	],
	"project": ["src/**/*.{js,ts,svelte}", "scripts/**/*.js"],
	"ignore": ["src/i18n/**"],
	"ignoreDependencies": ["@sveltejs/adapter-auto", "@testing-library/svelte", "tslib"],
	"ignoreExportsUsedInFile": true
}
