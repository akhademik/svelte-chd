{
  "name": "chd-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CHD Travel Monorepo with SvelteKit frontends and Sanity Studio backend",
  "scripts": {
    "dev": "pnpm --filter ./front-end2 dev",
    "dev:fe": "pnpm --filter ./front-end dev",
    "dev:fe2": "pnpm --filter ./front-end2 dev",
    "dev:be": "pnpm --filter ./back-end dev",
    "build": "pnpm --filter ./front-end2 build",
    "build:all": "pnpm -r build",
    "build:fe": "pnpm --filter ./front-end build",
    "build:fe2": "pnpm --filter ./front-end2 build",
    "build:be": "pnpm --filter ./back-end build",
    "check": "pnpm --filter ./front-end2 check",
    "check:all": "pnpm -r check",
    "check:fe": "pnpm --filter ./front-end check",
    "check:fe2": "pnpm --filter ./front-end2 check",
    "check:be": "pnpm --filter ./back-end check",
    "lint": "pnpm --filter ./front-end2 lint",
    "lint:all": "pnpm -r lint",
    "lint:fe": "pnpm --filter ./front-end lint",
    "lint:fe2": "pnpm --filter ./front-end2 lint",
    "lint:be": "pnpm --filter ./back-end lint",
    "format": "pnpm --filter ./front-end2 format",
    "format:all": "pnpm -r format",
    "format:fe": "pnpm --filter ./front-end format",
    "format:fe2": "pnpm --filter ./front-end2 format",
    "format:be": "pnpm --filter ./back-end format",
    "knip": "pnpm --filter ./front-end2 exec knip",
    "knip:all": "pnpm --filter ./front-end exec knip && pnpm --filter ./front-end2 exec knip && pnpm --filter ./back-end exec knip",
    "knip:fe": "pnpm --filter ./front-end exec knip",
    "knip:fe2": "pnpm --filter ./front-end2 exec knip",
    "knip:be": "pnpm --filter ./back-end exec knip",
    "i18n": "pnpm --filter ./front-end2 typesafe-i18n",
    "i18n:fe": "pnpm --filter ./front-end typesafe-i18n",
    "i18n:fe2": "pnpm --filter ./front-end2 typesafe-i18n"
  }
}
